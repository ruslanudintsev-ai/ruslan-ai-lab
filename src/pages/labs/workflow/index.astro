---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import WorkflowSimulator from "../../../components/WorkflowSimulator.astro";
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="AI Workflow Simulator — local demo" description="Explore a clearly labeled local simulation of issue, AI-assisted draft, PR, CI, owner review and release decision. No live agents or API connections.">
  <div class="shell page-pad">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={base}>Lab home</a><span aria-hidden="true">/</span> AI Workflow Simulator</nav>
    <header class="inner-hero">
      <p class="eyebrow"><span class="status-led" aria-hidden="true"></span> LAB 004 / EDUCATIONAL SIMULATION</p>
      <h1>AI Workflow Simulator<span class="heading-accent">.</span></h1>
      <p>Follow a possible path from task to review. Explore failed checks and revision loops — without a connected agent, GitHub automation or live deployment.</p>
    </header>
    <WorkflowSimulator />
    <section class="below-studio" aria-labelledby="workflow-facts">
      <div><p class="eyebrow">FACTS VS. SIMULATION</p><h2 id="workflow-facts">A real record is not a live integration.</h2></div>
      <div>
        <p><strong>Actual historical evidence:</strong> the lab's earlier <a class="text-link" href="https://github.com/ruslanudintsev-ai/ruslan-ai-lab/pull/5" target="_blank" rel="noopener noreferrer">Canvas Lab pull request ↗</a> and <a class="text-link" href="https://github.com/ruslanudintsev-ai/ruslan-ai-lab/actions/runs/41180037411" target="_blank" rel="noopener noreferrer">combined test run ↗</a> can be inspected independently on GitHub.</p>
        <p><strong>This walkthrough:</strong> locally constructed steps and button-selected CI results. It has no read-only API connection, model inference, authentication, agent execution, or ability to merge or deploy anything.</p>
        <p>The owner defines tasks, evaluates evidence and decides releases; AI-assisted implementation does not replace that responsibility.</p>
      </div>
    </section>
  </div>
</SiteLayout>
