---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import BrowserApisLab from "../../../components/BrowserApisLab.astro";
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Browser APIs Lab — local interaction and storage" description="Reorder a small engineering workflow using accessible controls or native drag and drop. Save and clear it explicitly in your browser; no accounts, tracking or backend.">
  <div class="shell page-pad">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={base}>Lab home</a><span aria-hidden="true">/</span> Browser APIs Lab</nav>
    <header class="inner-hero">
      <p class="eyebrow"><span class="status-led" aria-hidden="true"></span> LAB 005 / LOCAL BROWSER APIS</p>
      <h1>Browser APIs Lab<span class="heading-accent">.</span></h1>
      <p>Small browser capabilities, real controls, clear limits. Move workflow cards, then opt in to saving the order on your own device.</p>
    </header>
    <BrowserApisLab />
    <section class="below-studio" aria-labelledby="browser-source">
      <div><p class="eyebrow">SOURCE AND BOUNDARIES</p><h2 id="browser-source">You control the state.</h2></div>
      <div><p>The demonstration uses browser-native drag events, DOM updates and localStorage. It contains no form for personal information, backend, account login or remote model.</p>
      <p>Saved order is visible only to pages on this origin and browser profile; clearing site data also removes it. Browser privacy settings can make storage unavailable.</p>
      <a class="text-link" href="https://github.com/ruslanudintsev-ai/ruslan-ai-lab/tree/main/src" target="_blank" rel="noopener noreferrer">Inspect the source repository ↗</a></div>
    </section>
  </div>
</SiteLayout>
