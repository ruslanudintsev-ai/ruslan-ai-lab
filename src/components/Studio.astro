---
import { DEFAULT_STATE, generateCss } from "../domain/studio";
---
<section class="studio-frame" aria-label="Interactive CSS Studio">
  <form class="studio-controls" data-studio-form>
    <div class="panel-label"><span class="eyebrow">01 / CONTROLS</span><span class="panel-status">EDIT TOKENS</span></div>
    <h2>Shape the system.</h2>
    <p class="soft-copy">Adjust a few safe CSS values. The preview and generated code stay in sync.</p>
    <div class="field">
      <label for="accent">Accent color</label>
      <select id="accent" name="accent">
        <option value="#146B67" selected>Deep teal</option>
        <option value="#8054B2">Iris</option>
        <option value="#B44C38">Terracotta</option>
      </select>
    </div>
    <div class="field">
      <label for="radiusPx">Corner radius</label>
      <select id="radiusPx" name="radiusPx">
        <option value="0">0 px · Sharp</option>
        <option value="8">8 px · Subtle</option>
        <option value="16" selected>16 px · Rounded</option>
        <option value="24">24 px · Soft</option>
      </select>
    </div>
    <div class="field">
      <label for="columns">Grid columns</label>
      <select id="columns" name="columns">
        <option value="1">1 column</option>
        <option value="2" selected>2 columns</option>
        <option value="3">3 columns</option>
      </select>
    </div>
    <div class="field">
      <label for="gapPx">Grid gap</label>
      <select id="gapPx" name="gapPx">
        <option value="8">8 px</option>
        <option value="16" selected>16 px</option>
        <option value="24">24 px</option>
        <option value="32">32 px</option>
      </select>
    </div>
    <div class="field">
      <label for="motion">Animation</label>
      <select id="motion" name="motion">
        <option value="none" selected>Off</option>
        <option value="subtle">Subtle (respects reduced motion)</option>
      </select>
    </div>
    <button class="button button-secondary reset-button" type="button" data-reset>Reset tokens</button>
    <p class="fine-print" data-studio-help>JavaScript is needed for the live preview. The default CSS remains readable below.</p>
  </form>
  <div class="studio-output">
    <div class="preview-panel demo-preview" data-studio-preview>
      <div class="panel-label"><span class="eyebrow">02 / LIVE PREVIEW</span><span class="tiny-dot" aria-hidden="true"></span></div>
      <div class="preview-heading"><span class="preview-chip">DESIGN SYSTEM</span><h2>Small changes.<br />Clear impact.</h2><p>See how a handful of design choices change a working interface.</p></div>
      <div class="demo-preview__grid" aria-label="Preview layout">
        <div class="demo-preview__tile"><span class="tile-number">01</span><strong>Structure</strong><small>Simple by default</small></div>
        <div class="demo-preview__tile"><span class="tile-number">02</span><strong>Contrast</strong><small>Made to be readable</small></div>
        <div class="demo-preview__tile"><span class="tile-number">03</span><strong>Rhythm</strong><small>Space with intent</small></div>
      </div>
      <div class="preview-foot"><span aria-hidden="true" class="live-line"></span><span>Local, deterministic preview · no network API</span></div>
    </div>
    <div class="code-panel">
      <div class="panel-label"><span class="eyebrow">03 / GENERATED CSS</span><span class="panel-status">PLAIN TEXT</span></div>
      <label for="generated-css" class="visually-hidden">Generated CSS, selectable text</label>
      <textarea id="generated-css" class="code-area" data-studio-code readonly rows="17" spellcheck="false">{generateCss(DEFAULT_STATE)}</textarea>
      <div class="code-actions"><button class="button button-primary" type="button" data-copy>Copy generated CSS <span aria-hidden="true">↗</span></button><p class="fine-print" role="status" aria-live="polite" data-copy-status></p></div>
    </div>
  </div>
</section>
<script>
  import "../scripts/studio";
</script>
